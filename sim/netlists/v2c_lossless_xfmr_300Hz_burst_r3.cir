* inter-shot recovery
L_sec n1 nw 0.961 IC=-0.264789
R_w nw 0 20
C1 n1 0 1e-10 IC=-10674.4
C2 n2 0 1e-10 IC=-10944.4
C3 n3 0 1e-10 IC=-10157
L1 n2 m1 8.1e-05
R1 m1 n1 1
L2 n3 m2 3.2e-06
R2 m2 n2 1
L3 x m3 1e-08
R3 m3 n3 1
R_bleed n3 0 1e+07
C_block x P 1e-09 IC=-9815.6
V_P P 0 4000
.options method=gear reltol=1e-5
.control
set wr_singlescale
set wr_vecnames
option numdgt=9
tran 1.6594e-06 3.318885e-03 0 8.2972e-07 uic
wrdata /workspace/prs/sim/out/v2c_lossless_xfmr_300Hz_burst_r3.dat v(n1) v(n2) v(n3) v(x) i(L_sec)
quit
.endc
.end
